# Copy to .env and fill in. .env is never committed (it is in .gitignore).
# Every setting and its default is documented in app/settings.py.

# --- Models -------------------------------------------------------------
YOLO_MODEL_PATH=models/yolov8s.pt
HF_YOLO_REPO_ID=
HF_YOLO_FILENAME=
# OCR_MODELS_DIR=../FileReader/models

# --- Job 1: fetch from the source server ---------------------------------
SOURCE_TRANSPORT=sftp                 # sftp, or local (source is a folder on this machine)
SFTP_HOST=                            # <- server name or IP address
SFTP_PORT=22
SFTP_USERNAME=                        # <- login name
SFTP_PASSWORD=                        # <- password, OR leave blank and set SFTP_KEY_PATH
SFTP_KEY_PATH=                        # e.g. /home/<you>/.ssh/id_rsa
SFTP_KNOWN_HOSTS=                     # extra known_hosts file; ~/.ssh/known_hosts is always read
SFTP_TIMEOUT_SECONDS=30

SOURCE_ROOT=/Centric                  # remote folder above PBB/ and PIBB/
SOURCE_BANKS=PBB,PIBB
SOURCE_IMAGES_PATTERN={root}/{bank}/{date}/GWC/Images
SOURCE_TRIGGER_PATTERN=               # <- full path of the trigger file, e.g. {root}/{bank}/{date}/GWC/<name>

FETCH_WORKERS=6                       # parallel SFTP connections
FETCH_FILE_ATTEMPTS=3
FETCH_POLL_MINUTES=10                 # check for the trigger files again every N minutes...
FETCH_GIVE_UP_AT=20:00                # ...until this time, then exit 1
INCOMING_ROOT=data/incoming

# --- Job 2: processing ---------------------------------------------------
DATE_OFFSET_DAYS=0                    # no --date: today minus this many days
MAX_ATTEMPTS=3
WORKER_COUNT=1                        # 0 = size from the CPU count (see app/settings.py)
THREADS_PER_WORKER=1
SAVE_ARTIFACTS=false                  # true writes ~20 debug files per cheque

# --- Retention (end of job 2) -------------------------------------------
INCOMING_RETENTION_DAYS=30            # fetched .IMG files; 0 = keep forever
BATCH_RETENTION_DAYS=0                # output CSV + manifest; 0 = keep forever
