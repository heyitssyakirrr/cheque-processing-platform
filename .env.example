# Copy to .env and fill in. .env is never committed (it is in .gitignore).
# Every setting and its default is documented in app/settings.py.
# Keep comments on their own lines: "NAME=   # note" reads the note as the value.

# --- Models -------------------------------------------------------------
YOLO_MODEL_PATH=models/yolov8s.pt
HF_YOLO_REPO_ID=
HF_YOLO_FILENAME=
# OCR_MODELS_DIR=../FileReader/models

# --- Job 1: fetch from the source server ---------------------------------
# sftp, or local (the source is a folder on this machine)
SOURCE_TRANSPORT=sftp
# <- server name or IP address
SFTP_HOST=
SFTP_PORT=22
# <- login name
SFTP_USERNAME=
# <- password, OR leave blank and set SFTP_KEY_PATH (e.g. /home/<you>/.ssh/id_rsa)
SFTP_PASSWORD=
SFTP_KEY_PATH=
# extra known_hosts file; ~/.ssh/known_hosts is always read
SFTP_KNOWN_HOSTS=
SFTP_TIMEOUT_SECONDS=30

# remote folder above PBB/ and PIBB/
SOURCE_ROOT=/Centric
SOURCE_BANKS=PBB,PIBB
SOURCE_IMAGES_PATTERN={root}/{bank}/{date}/GWC/Images
# <- full path of the trigger file, e.g. {root}/{bank}/{date}/GWC/<name>
SOURCE_TRIGGER_PATTERN=

# parallel SFTP connections
FETCH_WORKERS=6
FETCH_FILE_ATTEMPTS=3
# check for the trigger files again every N minutes, until FETCH_GIVE_UP_AT, then exit 1
FETCH_POLL_MINUTES=10
FETCH_GIVE_UP_AT=20:00
INCOMING_ROOT=data/incoming

# --- Job 2: processing ---------------------------------------------------
# no --date: today minus this many days
DATE_OFFSET_DAYS=0
MAX_ATTEMPTS=3
# 0 = size from the CPU count (see app/settings.py)
WORKER_COUNT=1
THREADS_PER_WORKER=1
# true writes ~20 debug files per cheque (needed by diagnostics/ and export_batch.py)
SAVE_ARTIFACTS=false

# --- Retention (end of job 2) -------------------------------------------
# fetched .IMG files; 0 = keep forever
INCOMING_RETENTION_DAYS=30
# output CSV + manifest; 0 = keep forever
BATCH_RETENTION_DAYS=0
